# Authored teaching example. This path is NOT an active GitHub workflow.
# To use intentionally: create the exact azure-plan environment, IDs and LAB_RESOURCE_GROUP variables,
# configure the subject in TFA-036, then copy into your own .github/workflows directory.
name: TFA-036 scoped OIDC read
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  identify:
    if: github.ref == 'refs/heads/main'
    environment: azure-plan
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: azure/login@a641126d1b8aa4d1fa005f4f92df94a3a4c4c906 # v3.1.0
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
          audience: api://AzureADTokenExchange
      - name: Read exactly the training resource group
        shell: bash
        env:
          LAB_RESOURCE_GROUP: ${{ vars.LAB_RESOURCE_GROUP }}
          SUBSCRIPTION_ID: ${{ vars.AZURE_SUBSCRIPTION_ID }}
        run: |
          set -euo pipefail
          test -n "$LAB_RESOURCE_GROUP"
          test -n "$SUBSCRIPTION_ID"
          az group show --subscription "$SUBSCRIPTION_ID" --name "$LAB_RESOURCE_GROUP" --query '{id:id,location:location}' -o json
